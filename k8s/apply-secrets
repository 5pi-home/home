#!/usr/bin/env bash
# Create or update all Secrets from pass. They are deliberately not part of
# the kustomize builds, so `kubectl diff -k` works without access to pass.
#
# Usage: k8s/apply-secrets [kubectl apply flags, e.g. --dry-run=server]
set -euo pipefail

apply_flags=("$@")
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# secret <namespace> <name> <key>=<pass path>...
secret() {
  local ns=$1 name=$2
  shift 2
  local dir="$tmp/$ns/$name" kv
  mkdir -p "$dir"
  for kv in "$@"; do
    # printf drops pass' trailing newline, like the old $(pass ...) did.
    (umask 077 && printf '%s' "$(pass show "${kv#*=}")" > "$dir/${kv%%=*}")
  done
  kubectl -n "$ns" create secret generic "$name" --from-file="$dir" \
    --dry-run=client -o yaml | kubectl apply "${apply_flags[@]}" -f -
}

secret home-automation mqtt passwd=home/mqtt/passwd
