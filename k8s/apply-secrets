#!/usr/bin/env bash
# Create or update all Secrets from pass. They are deliberately not part of
# the kustomize builds, so `kubectl diff -k` works without access to pass.
# Runs with macOS' bash 3.2.
#
# Usage: k8s/apply-secrets [--diff]
set -euo pipefail

action="apply"
[[ "${1:-}" == --diff ]] && action="diff"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# pass entry without its trailing newline. Assigned first: a failing $(...)
# inside an argument would not stop the script, and we'd store "".
value() {
  local v
  v=$(pass show "$1")
  printf '%s' "$v"
}

# key <namespace>/<secret> <key>: stores stdin as that key of the Secret
key() {
  mkdir -p "$tmp/$1"
  (umask 077 && cat > "$tmp/$1/$2")
}

# apply <namespace>/<secret> [<type>]: creates/updates the Secret from its keys
apply() {
  kubectl -n "${1%%/*}" create secret generic "${1#*/}" --from-file="$tmp/$1" \
    --type="${2:-Opaque}" --dry-run=client -o yaml |
    if [[ $action == diff ]]; then kubectl diff -f - || [[ $? == 1 ]]; else kubectl apply -f -; fi
}

value home/mqtt/passwd | key home-automation/mqtt passwd
apply home-automation/mqtt

value home/oauth2_proxy/client_secret | key ingress-nginx/oauth2-proxy oauth2-proxy-client-secret
value home/oauth2_proxy/cookie_secret | key ingress-nginx/oauth2-proxy oauth2-proxy-cookie-secret
apply ingress-nginx/oauth2-proxy

value home/minio/admin | key data/minio root-password
apply data/minio

value home/grafana/oauth_client_secret | key monitoring/grafana oauth-client-secret
apply monitoring/grafana

value home/usenet/ewaka/username | key media/nzbget SERVER1_USERNAME
value home/usenet/ewaka/password | key media/nzbget SERVER1_PASSWORD
value home/usenet/nzbgeek-rss-url | key media/nzbget FEED1_URL
apply media/nzbget

# The bcrypt salt is random, so this Secret changes on every run.
registry_password=$(value home/image-registry/default)
registry_htpasswd=$(printf '%s\n' "$registry_password" | htpasswd -niB default)
printf '%s' "$registry_htpasswd" | key kube-system/registry htpasswd
apply kube-system/registry

P=$registry_password yq -n -o json '.auths["registry.d.42o.de"] = {
    "username": "default", "password": strenv(P), "auth": ("default:" + strenv(P) | @base64)}' |
  key minecraft/image-pull-secret .dockerconfigjson
apply minecraft/image-pull-secret kubernetes.io/dockerconfigjson
